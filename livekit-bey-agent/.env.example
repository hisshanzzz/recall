# LiveKit — cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret

# Google AI Studio — Gemini LLM + Gemini TTS (aistudio.google.com → API key)
GOOGLE_API_KEY=your_google_ai_studio_key

# Google Cloud — Speech-to-Text (Chirp) only; path to service account JSON
# Enable Speech-to-Text API in Google Cloud Console, then download key file.
# Windows: use forward slashes, e.g. ./service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Beyond Presence — app.bey.chat → API Keys
BEY_API_KEY=your_bey_key
BEY_AVATAR_ID=your_avatar_id

# Recall Next.js app — POST /api/sessions/end on call end
RECALL_APP_URL=https://your-app.netlify.app
SESSION_WEBHOOK_SECRET=same_value_as_nextjs_env

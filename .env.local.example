# LiveKit — cloud.livekit.io → Settings → Keys (same project as livekit-bey-agent)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Agent webhook — same value in livekit-bey-agent/.env
SESSION_WEBHOOK_SECRET=your_random_secret

# Session storage: omit Supabase keys or set USE_SUPABASE=false for in-memory (demo)
USE_SUPABASE=false

# Supabase (only when USE_SUPABASE=true)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
